generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERUSER
  STAFF
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  createdUsers User[] @relation("UserCreatedUsers")
  createdById  String?
  createdBy    User?   @relation("UserCreatedUsers", fields: [createdById], references: [id])

  @@index([username])
  @@index([role])
  @@index([isActive])
}

model Phone {
  id String @id @default(cuid())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  name  String
  ram   Int
  rom   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockBatches StockBatch[]

  @@index([name])
  @@index([ram])
  @@index([rom])
  @@index([name, ram, rom])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phones Phone[]

  @@index([name])
  @@index([isActive])
}

model StockBatch {
  id String @id @default(cuid())

  phoneId String
  phone   Phone  @relation(fields: [phoneId], references: [id], onDelete: Restrict)

  buyingPrice  Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  purchaseDate DateTime

  quantity          Int
  remainingQuantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@index([phoneId])
  @@index([purchaseDate])
  @@index([buyingPrice])
  @@index([sellingPrice])
  @@index([remainingQuantity])
  @@index([phoneId, remainingQuantity])
}

model Sale {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  saleDate DateTime @default(now())

  totalAmount Decimal @db.Decimal(12, 2)
  totalProfit Decimal @db.Decimal(12, 2)

  status SaleStatus @default(COMPLETED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  @@index([userId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  stockBatchId String
  stockBatch   StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  quantity Int

  buyingPrice  Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  profit Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([stockBatchId])
}